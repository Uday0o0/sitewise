# SITEWISE V4.2 — Environment Configuration Example
# Copy to .env and provide your API keys. NEVER commit .env to source control.

# AI Provider Selection: 'groq' | 'gemini' | 'auto' (defaults to 'auto', which selects whichever key is present)
SITEWISE_AI_PROVIDER=groq

# Groq Cloud Configuration
# Production models on Groq: 'openai/gpt-oss-120b' (default), 'openai/gpt-oss-20b', or 'qwen/qwen3.8-27b'
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=2048

# Google Gemini Configuration (Multimodal VLM support)
GEMINI_API_KEY=
SITEWISE_AI_MODEL=gemini-2.0-flash

# Meteorological Integration (Weather Advisory - Activity 5.3)
# Note: Open-Meteo is the default free public weather provider (no API key required).
# OpenWeatherMap is an optional secondary fallback if desired.
OPENWEATHERMAP_API_KEY=

# Storage and Operational Limits
SITEWISE_UPLOAD_DIR=
SITEWISE_AI_TIMEOUT_SECONDS=60
SITEWISE_AI_MAX_PASSAGES=8
SITEWISE_MAX_DOCUMENT_SIZE_MB=25

# Cloud Deployment & Networking (Render / Vercel)
# Database connection URL (defaults to SQLite; supports persistent disk paths on Render)
DATABASE_URL=sqlite+aiosqlite:///./sitewise.db

# Backend CORS Allowed Origins (comma-separated list of allowed frontend domains)
CORS_ORIGINS=http://localhost:5173,https://sitewise-frontend.vercel.app
FRONTEND_URL=https://sitewise-frontend.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Frontend API Target (set in Vercel project settings to your Render service URL)
VITE_API_BASE_URL=https://sitewise-backend.onrender.com
