# SITEWISE V4.2 — Environment Configuration Example
# Copy to .env and provide your API keys. NEVER commit .env to source control.

# AI Provider Selection: 'groq' | 'gemini' | 'auto' (defaults to 'auto', which selects whichever key is present)
SITEWISE_AI_PROVIDER=groq

# Groq Cloud Configuration
# Production models on Groq Free Tier: 'llama-3.3-70b-versatile' (default) or 'llama-3.1-8b-instant'
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration
GEMINI_API_KEY=
SITEWISE_AI_MODEL=gemini-2.0-flash

# Operational Limits
SITEWISE_AI_TIMEOUT_SECONDS=60
SITEWISE_AI_MAX_PASSAGES=8
SITEWISE_MAX_DOCUMENT_SIZE_MB=25
